<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Catppuccin Frappé -->
  <Color x:Key="RosewaterColor">#f2d5cf</Color>
  <Color x:Key="FlamingoColor">#eebebe</Color>
  <Color x:Key="PinkColor">#f4b8e4</Color>
  <Color x:Key="MauveColor">#ca9ee6</Color>
  <Color x:Key="RedColor">#e78284</Color>
  <Color x:Key="MaroonColor">#ea999c</Color>
  <Color x:Key="PeachColor">#ef9f76</Color>
  <Color x:Key="YellowColor">#e5c890</Color>
  <Color x:Key="GreenColor">#a6d189</Color>
  <Color x:Key="TealColor">#81c8be</Color>
  <Color x:Key="SkyColor">#99d1db</Color>
  <Color x:Key="SapphireColor">#85c1dc</Color>
  <Color x:Key="BlueColor">#8caaee</Color>
  <Color x:Key="LavenderColor">#babbf1</Color>
  <Color x:Key="TextColor">#c6d0f5</Color>
  <Color x:Key="Subtext1Color">#b5bfe2</Color>
  <Color x:Key="Subtext0Color">#a5adce</Color>
  <Color x:Key="Overlay2Color">#949cbb</Color>
  <Color x:Key="Overlay1Color">#838ba7</Color>
  <Color x:Key="Overlay0Color">#737994</Color>
  <Color x:Key="Surface2Color">#626880</Color>
  <Color x:Key="Surface1Color">#51576d</Color>
  <Color x:Key="Surface0Color">#414559</Color>
  <Color x:Key="BaseColor">#303446</Color>
  <Color x:Key="MantleColor">#292c3c</Color>
  <Color x:Key="CrustColor">#232634</Color>

  <SolidColorBrush x:Key="Rosewater" Color="{StaticResource RosewaterColor}"/>
  <SolidColorBrush x:Key="Flamingo"  Color="{StaticResource FlamingoColor}"/>
  <SolidColorBrush x:Key="Pink"      Color="{StaticResource PinkColor}"/>
  <SolidColorBrush x:Key="Mauve"     Color="{StaticResource MauveColor}"/>
  <SolidColorBrush x:Key="Red"       Color="{StaticResource RedColor}"/>
  <SolidColorBrush x:Key="Maroon"    Color="{StaticResource MaroonColor}"/>
  <SolidColorBrush x:Key="Peach"     Color="{StaticResource PeachColor}"/>
  <SolidColorBrush x:Key="Yellow"    Color="{StaticResource YellowColor}"/>
  <SolidColorBrush x:Key="Green"     Color="{StaticResource GreenColor}"/>
  <SolidColorBrush x:Key="Teal"      Color="{StaticResource TealColor}"/>
  <SolidColorBrush x:Key="Sky"       Color="{StaticResource SkyColor}"/>
  <SolidColorBrush x:Key="Sapphire"  Color="{StaticResource SapphireColor}"/>
  <SolidColorBrush x:Key="Blue"      Color="{StaticResource BlueColor}"/>
  <SolidColorBrush x:Key="Lavender"  Color="{StaticResource LavenderColor}"/>
  <SolidColorBrush x:Key="Text"      Color="{StaticResource TextColor}"/>
  <SolidColorBrush x:Key="Subtext1"  Color="{StaticResource Subtext1Color}"/>
  <SolidColorBrush x:Key="Subtext0"  Color="{StaticResource Subtext0Color}"/>
  <SolidColorBrush x:Key="Overlay2"  Color="{StaticResource Overlay2Color}"/>
  <SolidColorBrush x:Key="Overlay1"  Color="{StaticResource Overlay1Color}"/>
  <SolidColorBrush x:Key="Overlay0"  Color="{StaticResource Overlay0Color}"/>
  <SolidColorBrush x:Key="Surface2"  Color="{StaticResource Surface2Color}"/>
  <SolidColorBrush x:Key="Surface1"  Color="{StaticResource Surface1Color}"/>
  <SolidColorBrush x:Key="Surface0"  Color="{StaticResource Surface0Color}"/>
  <SolidColorBrush x:Key="Base"      Color="{StaticResource BaseColor}"/>
  <SolidColorBrush x:Key="Mantle"    Color="{StaticResource MantleColor}"/>
  <SolidColorBrush x:Key="Crust"     Color="{StaticResource CrustColor}"/>

  <SolidColorBrush x:Key="LockAccent"      Color="{StaticResource MauveColor}"/>
  <SolidColorBrush x:Key="SleepAccent"     Color="{StaticResource BlueColor}"/>
  <SolidColorBrush x:Key="HibernateAccent" Color="{StaticResource TealColor}"/>
  <SolidColorBrush x:Key="ShutdownAccent"  Color="{StaticResource RedColor}"/>

  <SolidColorBrush x:Key="OverlayBackdrop" Color="#B3000000"/>

</ResourceDictionary>
